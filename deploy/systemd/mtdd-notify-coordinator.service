[Unit]
Description=MTDD notify coordinator (MtddNotify only deployment)
After=network.target

[Service]
Type=simple
User=mtdd
Group=mtdd
RuntimeDirectory=mtdd
RuntimeDirectoryMode=0750
EnvironmentFile=-/etc/mtdd/mtdd-notify.env
Environment=MTDD_ENV=production
Environment=MTDD_LISTEN=unix:/run/mtdd/grpc.sock
Environment=MTDD_UNIX_SOCKET_MODE=0660
Environment=MTDD_NOTIFY_ENABLED=1
Environment=MTDD_HEALTH_REQUIRE_PG=0
Environment=MTDD_GRPC_REFLECTION=0
ExecStart=/usr/local/bin/mtdd_server
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Add the nginx user to the mtdd group so nginx can connect to the unix socket.
